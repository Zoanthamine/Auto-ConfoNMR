define =
integrator = md
dt         = 0.001   ; ps
nsteps     = 200000
comm-grps  = system
;
nstxout = 0
nstvout = 0
nstfout = 0
nstlog  = 100
nstenergy = 100
nstxout-compressed = 100
compressed-x-grps  = system
periodic-molecules = yes
;
pbc = xyz
cutoff-scheme = verlet
rlist = 0.5
coulombtype   = PME
rcoulomb      = 0.5
vdwtype       = cut-off
rvdw          = 0.5
DispCorr      = no
;
Tcoupl  = V-rescale
tau_t   = 0.2
tc_grps = system
ref_t   = 1500
;
Pcoupl     = berendsen
pcoupltype = isotropic
tau_p = 1.5
ref_p = 1.0
compressibility = 4.5e-5
;
gen_vel  = yes
gen_temp = 100
gen_seed = -1
;
freezegrps  = 
freezedim   = 
constraints = hbonds
;
annealing = periodic
annealing_npoints = 4
annealing_time = 0 30 80 200
annealing_temp = 0 2000 2000 0

